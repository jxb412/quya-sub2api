+        $this->sendNoIndexHeaders();
+        header('Referrer-Policy: no-referrer');
+        if ($isPage && ($method === 'GET' || $method === 'HEAD')) {
+            $error = $this->bootstrapEmbeddedSession();
+            $session = $this->session();
+            $mountPrefix = $this->mountPrefix();
+            include __DIR__ . '/../templates/subscription_reset.php';
+            return true;
+        }
+        if (!$isApi) { $this->json(405, '请求方式不支持'); return true; }
+        $session = $this->requireSession();
+        $userId = (int) $session['user_id'];
+        try {
+            if ($method === 'GET' && $path === $base . '/preview') {
+                $id = (string) ($_GET['subscription_id'] ?? '');
+                if (!ctype_digit($id) || (int) $id <= 0) { throw new RuntimeException('请选择有效的订阅'); }
